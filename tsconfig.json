{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@aimbrace/core": ["./packages/core/src/index.ts"],
      "@aimbrace/loader": ["./packages/loader/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "plugins/*/src",
    "plugins/*/test",
    "examples/*/src",
    "examples/*/test"
  ]
}

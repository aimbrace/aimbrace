{
  "name": "create-aimbrace",
  "version": "0.1.0",
  "description": "Scaffold a Cordis app: pick a host (Hono or Fastify) and optionally an offline agent.",
  "license": "MIT",
  "type": "module",
  "bin": { "create-aimbrace": "./bin/create-aimbrace.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["bin", "dist", "templates"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "prebuild": "node scripts/copy-templates.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "repository": { "type": "git", "url": "git+https://github.com/aimbrace/aimbrace.git", "directory": "scaffolder/packages/create" },
  "homepage": "https://aimbrace.github.io",
  "keywords": ["cordis", "scaffold", "create", "hono", "fastify"]
}

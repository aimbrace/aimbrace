{
  "name": "aimbrace-monorepo",
  "private": true,
  "type": "module",
  "description": "AIMBRACE - a TypeScript application composition runtime built on Cordis.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm run lint && pnpm run build && pnpm run verify:packages && pnpm run verify:consumer && pnpm run typecheck && pnpm run test && pnpm run test:examples",
    "graph": "node scripts/print-graph.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "test:examples": "vitest run --config vitest.examples.config.ts",
    "verify:consumer": "node scripts/verify-consumer.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}

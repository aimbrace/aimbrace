{
  "name": "@aimbrace/loader",
  "version": "0.1.0",
  "description": "Load AIMBRACE apps from config modules and JSON manifests, and discover installed plugins.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aimbrace/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimbrace/aimbrace.git",
    "directory": "packages/loader"
  },
  "homepage": "https://aimbrace.github.io",
  "keywords": [
    "aimbrace",
    "config",
    "loader",
    "manifest"
  ]
}

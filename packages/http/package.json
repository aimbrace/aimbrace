{
  "name": "@aimbrace/http",
  "version": "0.1.0",
  "description": "Host-neutral HTTP contract for AIMBRACE: routes, middleware and a request-scoped dispatcher on Web Request and Response.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aimbrace/core": "workspace:*",
    "valibot": "1.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimbrace/aimbrace.git",
    "directory": "packages/http"
  },
  "homepage": "https://aimbrace.github.io",
  "keywords": [
    "aimbrace",
    "http",
    "routes",
    "web-standards"
  ]
}
